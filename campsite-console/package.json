{
  "name": "campsite-console",
  "private": true,
  "version": "1.0.0",
  "description": "Operations console of the campsite power network (reception, hosts, service, back office, administration)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test --project=e2e",
    "screenshots": "playwright test --project=screenshots",
    "generate-api": "openapi-typescript ${CAMPSITE_API_DOCS:-http://localhost:8080/v3/api-docs} -o src/api/schema.d.ts"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^6.5.0",
    "@mui/material": "^6.5.0",
    "@mui/x-data-grid": "^7.29.13",
    "@tanstack/react-query": "^5.104.3",
    "echarts": "^5.6.0",
    "echarts-for-react": "^3.0.6",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^26.1.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.3",
    "vite": "^6.4.4",
    "vitest": "^3.2.7"
  }
}
